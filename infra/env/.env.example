APP_VERSION=local
ENVIRONMENT=local

# Backend API
BACKEND_API_PORT=8000
RAG_SERVICE_URL=http://localhost:8001
INGEST_SERVICE_URL=http://localhost:8002

# RAG Service
RAG_SERVICE_PORT=8001
DEFAULT_TOP_K=4

# Ingest Service
INGEST_SERVICE_PORT=8002
DOCS_HOST_PATH=../../data/docs
DOCS_PATH=/app/data/docs
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3:8b
EMBEDDING_MODEL=all-minilm

# Milvus
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530
MILVUS_UI_PORT=9091
MILVUS_COLLECTION=sovra_knowledge_base

# MinIO for Milvus standalone
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin