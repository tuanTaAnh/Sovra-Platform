APP_VERSION=local
ENVIRONMENT=local

# Backend API
BACKEND_API_PORT=8000
RAG_SERVICE_URL=http://localhost:8001
INGEST_SERVICE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./backend_api.db
HTTP_TIMEOUT_SECONDS=300

# RAG Service
RAG_SERVICE_PORT=8001
DEFAULT_TOP_K=3

# Ingest Service
INGEST_SERVICE_PORT=8002
DOCS_HOST_PATH=../../data/docs
DOCS_PATH=/app/data/docs
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2:1b
EMBEDDING_MODEL=all-minilm

# Milvus Lite
MILVUS_DB_PATH=/app/data/sovra_milvus.db
MILVUS_COLLECTION=sovra_knowledge_base
EMBEDDING_DIM=384

# Old Milvus Standalone values - not used by Milvus Lite
# MILVUS_HOST=host.docker.internal
# MILVUS_PORT=19530
# MILVUS_UI_PORT=9091

# Old MinIO for Milvus Standalone - not used by Milvus Lite
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin